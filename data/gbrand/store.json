      "excludesPrintFee": true,
      "note": "Confirmed by GBRAND. At KSh 1,499 per kit this equals the normal price for two, so no discount line appears in the bag. If pairPrice is ever set below 2 × kit price, the discount logic kicks in automatically."
    },
    "print": {
      "enabled": true,
      "fee": 500,
      "nameMaxLength": 12,
      "nameCharset": "A-Z, space, apostrophe, dot, hyphen",
      "numberRange": [
        0,
        99
      ]
    }
  },
  "homepage": [
    {
      "block": "ticker"
    },
    {
      "block": "hero.kitWall",
      "props": {
        "layout": "split",
        "eyebrow": "Jerseys · Apparel · Accessories",
        "headline": [
          "Wear your",
          "legacy"
        ],
        "outlineWord": "legacy",
        "body": "Club jerseys and everyday apparel, delivered across Kenya. Pick your size, send your order on WhatsApp and pay with M-Pesa.",
        "primaryCta": {
          "label": "Shop jerseys",
          "href": "/shop"
        },
        "secondaryCta": {
          "label": "Order on WhatsApp",
          "action": "whatsapp.general"
        },
        "stats": [
          "kitCount",
          "clubCount",
          {
            "value": "1,499",
            "label": "KSh, every kit"
          }
        ],
        "stack": {
          "source": "newest",
          "exclude": "spotlight",
          "count": 3,
          "tag": "Just dropped"
        }
      }
    },
    {
      "block": "categories.clubTiles",
      "props": {
        "eyebrow": "Shop by club",
        "title": "Pick your side",
        "sort": "byCountDesc",
        "showCrest": true
      }
    },
    {
      "block": "products.grid",
      "props": {
        "eyebrow": "Fresh on the rail",
        "title": "New this week",
        "sort": "newest",
        "limit": 8
      }
    },
    {
      "block": "promo.pairBundle",
      "props": {
        "title": [
          "Any 2 kits",
          "KSh 2,998"
        ],
        "body": "Every kit is KSh 1,499. Grab two and mix clubs, sizes and styles.",
        "images": [
          "man-city-black-bee",
          "liverpool-white-retro"
        ],
        "cta": {
          "label": "Build your pair",
          "href": "/shop"
        },
        "eyebrow": "Double up"
      }
    },
    {
      "block": "product.spotlight",
      "props": {
        "tag": "Kit of the week",
        "product": "arsenal-green-leaf",
        "inlineSizePicker": true
      }
    },
    {
      "block": "brand.teaser",
      "props": {
        "eyebrow": "Our story",
        "body": "GBRAND puts the map of Kenya at the heart of everything we sell. Your club, your town, your people. Wear them with pride.",
        "cta": {
          "label": "Read our story",
          "href": "/brand"
        }
      }
    },
    {
      "block": "magazine.latest",
      "props": {
        "eyebrow": "GBRAND Magazine",
        "title": "The Legacy",
        "limit": 3
      }
    },
    {
      "block": "trust.strip",
      "props": {
        "items": [
          {
            "icon": "truck",
            "title": "Delivery",
            "body": "Nairobi doorstep, Pickup countrywide"
          },
          {
            "icon": "phone",
            "title": "M-Pesa",
            "body": "Pay once we confirm your order"
          },
          {
            "icon": "swap",
            "title": "Size swap",
            "body": "Wrong size? We'll swap it"
          },
          {
            "icon": "whatsapp",
            "title": "WhatsApp",
            "body": "Your bag arrives as one clear message"
          }
        ]
      }
    },
    {
      "block": "join.whatsapp",
      "props": {
        "title": "New kits first",
        "body": "Get drop alerts and restocks on WhatsApp. No spam, just kits.",
        "button": "Join drop alerts on WhatsApp",
        "message": "Hi GBRAND, add me to new kit alerts. (Reply STOP anytime to leave.)",
        "note": "Opens WhatsApp with a message ready to send. Reply STOP any time to leave."
      }
    }
  ],
  "checkout": {
    "mode": "whatsapp-precheckout",
    "fields": [
      {
        "id": "name",
        "label": "Name",
        "type": "text",
        "required": false
      },
      {
        "id": "phone",
        "label": "Phone",
        "type": "tel",
        "required": false,
        "placeholder": "07xx xxx xxx"
      },
      {
        "id": "fulfilment",
        "label": "Delivery",
        "type": "pills",
        "options": [
          "Delivery in Nairobi",
          "Pickup",
          "Courier upcountry"
        ],
        "default": "Delivery in Nairobi"
      },
      {
        "id": "location",
        "label": "Town or estate",
        "type": "text",
        "required": false,
        "placeholder": "e.g. Kasarani, Nakuru town"
      }
    ],
    "deliveryFee": "confirmed-on-whatsapp",
    "messageTemplate": "Hi GBRAND, I'd like to order:\n{{#lines}}• {{name}} (No.{{no}}) — Size {{size}}{{#print}} — Print: {{printName}} {{printNumber}}{{/print}} ×{{qty}} — {{lineTotal}}\n{{/lines}}\nSubtotal: {{subtotal}}{{#discount}}\nPair deal: −{{discount}}{{/discount}}\nTotal: {{total}} + delivery\n\nName: {{name}}\nPhone: {{phone}}\nDelivery: {{fulfilment}}\nLocation: {{location}}"
  },
  "policies": [
    "Delivery across Kenya",
    "Pay with M-Pesa after confirmation",
    "Size swap",
    "Cash on delivery in Nairobi"
  ],
  "seo": {
    "titleTemplate": "%s · GBRAND",
    "homeTitle": "GBRAND · Wear Your Legacy",
    "ogImage": "/assets/products/arsenal-green-leaf.webp"
  },
  "layout": {
    "wrap": {
      "mobile": "100%",
      "tablet": "90vw",
      "desktop": "min(80vw,1360px)"
    }
  }
